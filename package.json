{
  "name": "n8n-nodes-wachatty",
  "version": "1.0.1",
  "description": "n8n community node for sending WhatsApp messages through the WaChatty API",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "whatsapp",
    "wachatty"
  ],
  "author": {
    "name": "WaChatty",
    "email": "info@wachatty.com",
    "url": "https://wachatty.com"
  },
  "homepage": "https://wachatty.com",
  "bugs": {
    "url": "https://github.com/vaibhav-joon/wachatty/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaibhav-joon/wachatty.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run lint && npm run build && node --test test/interactive.test.cjs",
    "test:package": "npx @n8n/scan-community-package n8n-nodes-wachatty",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test:interactive": "npm run build && node --test test/interactive.test.cjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/WaChattyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WaChatty/WaChatty.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
